#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>

const char* ssid="JIDIHOME 2.4";
const char* password="JIDIConnect2026";

String SUPABASE_URL=
"https://tzdbfthqexfsttufmtoa.supabase.co";

String SUPABASE_KEY=
"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InR6ZGJmdGhxZXhmc3R0dWZtdG9hIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkxNTM3MjYsImV4cCI6MjA5NDcyOTcyNn0.ZUEgbez8Po8iyDBwuE0PyQdf7CRNHLlUr_sUmlNSt5U";

String DEVICE_ID="AF-001";

String COMMAND_URL=
SUPABASE_URL+
"/rest/v1/control_status?select=*&device_id=eq.AF-001";

String SENSOR_URL=
SUPABASE_URL+
"/rest/v1/sensor_data";

#define SOIL1 35
#define SOIL2 34
#define SOIL3 32

#define RELAY1 21
#define RELAY2 19
#define RELAY3 18
#define RELAY4 5

const bool RELAY_ON=LOW;
const bool RELAY_OFF=HIGH;

int dryValue=3200;
int wetValue=1400;

bool relay1=false;
bool relay2=false;
bool relay3=false;
bool relay4=false;

String mode="automatic";

unsigned long previousMillis=0;
const long interval=3000;

void connectWiFi()
{
    if(
      WiFi.status()==WL_CONNECTED
    )
    return;

    WiFi.begin(
      ssid,
      password
    );

    Serial.print(
      "Connecting"
    );

    while(
      WiFi.status()!=WL_CONNECTED
    )
    {
        delay(500);
        Serial.print(".");
    }

    Serial.println();
    Serial.println(
      WiFi.localIP()
    );
}

int readMoisture(
    int pin
)
{
    return constrain(
        map(
            analogRead(pin),
            dryValue,
            wetValue,
            0,
            100
        ),
        0,
        100
    );
}

void applyRelays()
{
    digitalWrite(
      RELAY1,
      relay1 ?
      RELAY_ON :
      RELAY_OFF
    );

    digitalWrite(
      RELAY2,
      relay2 ?
      RELAY_ON :
      RELAY_OFF
    );

    digitalWrite(
      RELAY3,
      relay3 ?
      RELAY_ON :
      RELAY_OFF
    );

    digitalWrite(
      RELAY4,
      relay4 ?
      RELAY_ON :
      RELAY_OFF
    );
}

void automaticControl(
    int s1,
    int s2,
    int s3
)
{
    relay2=s1<40;
    relay3=s2<40;
    relay4=s3<40;

    relay1=
    relay2||
    relay3||
    relay4;

    applyRelays();
}

void fetchCommands()
{
    HTTPClient http;

    http.begin(
      COMMAND_URL
    );

    http.addHeader(
      "apikey",
      SUPABASE_KEY
    );

    http.addHeader(
      "Authorization",
      "Bearer "+
      SUPABASE_KEY
    );

    int code=
    http.GET();

    if(code!=200)
    {
        http.end();
        return;
    }

    DynamicJsonDocument
    doc(1024);

    deserializeJson(
      doc,
      http.getString()
    );

    JsonObject data=
    doc[0];

    mode=
    data["mode"]|
    "automatic";

    if(mode=="manual")
    {
        relay1=
        data["relay1"];

        relay2=
        data["relay2"];

        relay3=
        data["relay3"];

        relay4=
        data["relay4"];

        applyRelays();
    }

    http.end();
}

void setup()
{
    Serial.begin(
      115200
    );

    pinMode(
      SOIL1,
      INPUT
    );

    pinMode(
      SOIL2,
      INPUT
    );

    pinMode(
      SOIL3,
      INPUT
    );

    pinMode(RELAY1,OUTPUT);
    pinMode(RELAY2,OUTPUT);
    pinMode(RELAY3,OUTPUT);
    pinMode(RELAY4,OUTPUT);

    applyRelays();

    connectWiFi();
}

void loop()
{
    connectWiFi();

    if(
      millis()-previousMillis
      >=interval
    )
    {
        previousMillis=
        millis();

        int s1=
        readMoisture(
          SOIL1
        );

        int s2=
        readMoisture(
          SOIL2
        );

        int s3=
        readMoisture(
          SOIL3
        );

        fetchCommands();

        if(
          mode==
          "automatic"
        )
        {
            automaticControl(
              s1,
              s2,
              s3
            );
        }

        Serial.println(
          mode
        );
    }
}